{% import "components/link.njk" as linkComponent %}

<div>
  <nav>
    <p>menu</p>
    <ul class="menu">
      <li class="col-span-5">
        {{
          linkComponent.link(
            href="https://blog.fschoenfeldt.de/",
            text="blog",
            external=true,
            title="my blog",
            customClasses="no-underline",
            sublabel="blog.fschoenfeldt.de",
            sublabelClasses="fill-white hover:fill-white underline text-white",
            showIcon=true
          )
        }}
      </li>
      <li class="col-span-2">
        {{
          linkComponent.link(
            href="mailto:frederikschoenfeldt@gmail.com",
            text="hello",
            title="contact me via email",
            customClasses="no-underline",
            sublabel="frederikschoenfeldt@gmail.com",
            sublabelClasses="underline text-white"
          )
        }}
      </li>
      <li class="projects relative col-span-5">
        <div class="relative z-10 flex items-center justify-between gap-2 p-4">
          <p>projects</p>
          {# i need to override many of assets/css/components/misc.css here #}
          {{
            linkComponent.link(
              href="/projects" | url,
              text="all projects",
              title="see all projects",
              customClasses="!flex-row !h-auto !p-0 !w-auto",
              sublabelClasses="fill-white hover:fill-white underline text-white"
            )
          }}
        </div>
        <div class="md:grid md:grid-cols-2">
          <div
            class="relative bg-laufmaus-accent md:rounded-bl dark:bg-gray-800"
          >
            {%
              call linkComponent.link(
                href="/laufmaus" | url,
                title="learn more",
                customClasses="relative z-10 no-underline",
                sublabel="learn more",
                sublabelClasses="w-max light:!text-laufmaus-complement dark:!text-gray-100 underline"
              )
            %}
              <div
                class="flex w-full items-center justify-between gap-2 font-spacegrotesk !text-3xl font-bold"
              >
                <div
                  class="light:!text-laufmaus-complement dark:!text-gray-100"
                >
                  laufma
                  <br />
                  us
                </div>
                <div
                  class="text-nowrap bg-laufmaus-complement p-2 py-1 text-lg text-gray-100 md:text-sm"
                >
                  new!
                </div>
              </div>
            {% endcall %}
          </div>
          <div class="relative bg-blue-400">
            {% set image = "src/images/fotohaecker_bg.jpg" | sharp %}
            <img
              class="absolute top-0 h-full w-full rounded-b object-cover md:rounded-bl-none"
              src="{% getUrl image | resize({ width: 500 }) | webp %}"
              aria-hidden="true"
            />
            {%
              call linkComponent.link(
                href="/fotohaecker" | url,
                title="learn more",
                customClasses="relative z-10 no-underline",
                sublabel="learn more",
                sublabelClasses="gray-bg underline"
              )
            %}
              <div class="w-full">
                <span class="gray-bg">fotohäcker</span>
              </div>
            {% endcall %}
          </div>
        </div>
      </li>
      <li class="col-span-8">
        {{
          linkComponent.link(
            href="https://unsplash.com/@fschoenfeldt",
            text="photography",
            external=true,
            title="my photos",
            customClasses="no-underline",
            sublabel="gallery",
            sublabelClasses="fill-white hover:fill-white underline text-white",
            showIcon=true
          )
        }}
      </li>
      <li class="col-span-4">
        {{
          linkComponent.link(
            href="https://soundcloud.com/frederikschoenfeldt",
            text="tunes",
            external=true,
            title="my tunes",
            customClasses="no-underline",
            sublabel="soundcloud",
            sublabelClasses="fill-white hover:fill-white underline text-white",
            showIcon=true
          )
        }}
      </li>
    </ul>
  </nav>
</div>
