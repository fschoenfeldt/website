{#
    Feature comparison between manufacturer apps and Laufmaus.

    Expects `featureRows`: [{ title, icon, manufacturerSupport, laufmausSupport }]
    where support is true, false or "soon".
#}
{% set rows = featureRows or [] %}

{% set tableColumns = [
    {
        key: "feature",
        label: "Feature",
        cellClass: "flex items-center gap-2 p-1 md:p-4 font-bold md:font-medium"
    },
    {
        key: "manufacturer",
        label: "Manufacturer",
        align: "center",
        mobileLabel: "Manufacturer",
        cellClass: "block xs:ml-auto md:table-cell p-1 md:p-4 text-center"
    },
    {
        key: "laufmaus",
        label: "Laufmaus (Free)",
        align: "center",
        mobileLabel: "Laufmaus",
        cellClass: "block md:table-cell p-1 md:p-4 text-center"
    }
] %}

{% set tableRows = [] %}
{% for row in rows %}
    {% set _ = tableRows.push({
        cells: {
            feature: { kind: "icon-text", icon: row.icon, value: row.title },
            manufacturer: { kind: "support", value: row.manufacturerSupport },
            laufmaus: { kind: "support", value: row.laufmausSupport }
        }
    }) %}
{% endfor %}

{% set tableClass = "" %}
{% set tableRowClass = "" %}
{% set tableCaption = "Feature comparison between manufacturer apps and Laufmaus" %}
{% include "components/stacked_table.njk" %}
