            </div>
        </section>
        <section class="light bg-gray-100" id="compatible-devices">
            <div class="container">
                <div class="description col-span-12 !space-y-8 overflow-hidden">
                    <h2>
                        Compatible Devices
                    </h2>
                    <div class="!space-y-4">
                        <h3 class="!text-xl">🏅 Confirmed</h3>
                        <p class="text-sm md:max-w-3xl">
                            Reported working by a user or tested by us.
                        </p>
                        {% set compatibilityTier = "confirmed" %}
                        {% include "components/laufmaus/compatibility_table.njk" %}
                    </div>
                    <div class="!space-y-4">
                        <h3 class="!text-xl">🥈 Very likely</h3>
                        <p class="text-sm md:max-w-3xl">
                            Same protocol and a speed limit taken from the manufacturer's model list, but nobody has reported back from this exact model yet. You're welcome to try it and let us know!
                        </p>
                        {% set compatibilityTier = "likely" %}
                        {% include "components/laufmaus/compatibility_table.njk" %}
                    </div>
                    <div class="!space-y-4">
                        <h3 class="!text-xl">🥉 Untested</h3>
                        <p class="text-sm md:max-w-3xl">
                            Built from the protocol specification, but never tried against a real treadmill.
                            {{
                                linkComponent.link(
                                    href="mailto:apps@fschoenfeldt.de",
                                    text="Please tell us how it goes!",
                                    title="Write to apps@fschoenfeldt.de",
                                    customClasses="underline"
                                )
                            }}
                        </p>
                        {% set compatibilityTier = "untested" %}
                        {% include "components/laufmaus/compatibility_table.njk" %}
                    </div>
                    <p class="text-sm !text-gray-600 md:max-w-3xl">
                        Model names refer to the Bluetooth name your treadmill advertises, which is not always the name printed on the device. The lowest selectable speed is 2 km/h on KingSmith pads and 0.5 km/h on FTMS treadmills.
                    </p>
                    <div class="!space-y-4">
                        <h3 class="!text-xl">Heart Rate Monitors</h3>
                        <ul class="list-disc list-inside ps-4 space-y-1 text-sm">
                            <li>WAHOO TICKR</li>
                            <li>WAHOO TRACKR</li>
                            <li>Any Bluetooth HRM device following the "BLE Heart Rate Service GATT-Standard"</li>
                        </ul>
