                        laufmausSupport: true
                    },
                    {
                        title: "Custom Speed Options",
                        icon: "sliders-horizontal",
                        manufacturerSupport: false,
                        laufmausSupport: true
                    },
                    {
                        title: "0.1 km/h Speed Increment",
                        icon: "gauge",
                        manufacturerSupport: false,
                        laufmausSupport: true
                    }
                ] %}
                <div>{% include "components/laufmaus/feature_table.njk" %}</div>
                <div>
                    {% include "components/laufmaus/appstore_cta.njk" %}
