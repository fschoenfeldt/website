---
title: Laufmaus
description: Feature-rich WalkingPad app with heart rate monitoring, Live Activity support, and Apple Health integration. No login required, quick start, and accurate calorie tracking.
ogImage: /img/laufmaus/o_graph.png
jsonLdType: SoftwareApplication
jsonLdOperatingSystem: iOS, Android
jsonLdCategory: HealthApplication
itunesAppId: 6759827194
layout: layouts/project.njk
eleventyExcludeFromCollections: false
# Ported from src/services/walkingpad/compatibility.ts in the Laufmaus app.
# Model names, name prefixes and maximum speeds come from the vendor product table
# (allProducts.json in KS Fit 6.5.6).
# tier: confirmed = reported working or tested by us; likely = same protocol and a
# vendor speed limit, but no report from this exact model; untested = protocol built
# from its specification, never seen against real hardware.
compatibility:
  # KingSmith / WalkingPad, classic FE00 protocol
  - models: "WalkingPad A1, A1 Pro"
    namePrefixes: ["A1", "A2"]
    maxSpeedKmh: 6
    protocol: FE00
    tier: confirmed
  - models: "WalkingPad C2"
    namePrefixes: ["C2", "c2", "KS-BDC2"]
    maxSpeedKmh: 6
    protocol: FE00
    tier: confirmed
  - models: "WalkingPad P1"
    namePrefixes: ["P1"]
    maxSpeedKmh: 6
    protocol: FE00
    tier: confirmed
  - models: "WalkingPad C1, S1"
    namePrefixes: ["C1", "S1"]
    maxSpeedKmh: 6
    protocol: FE00
    tier: likely
  - models: "WalkingPad R1 Pro"
    namePrefixes: ["R1"]
    maxSpeedKmh: 10
    protocol: FE00
    tier: confirmed
  - models: "R1 variants, KS-RS, MC21"
    namePrefixes: ["RA", "RE", "RF", "RM", "RO", "KS-RS", "KS-MC21", "KS-HC-R1ST", "KS-SC-R1SA"]
    maxSpeedKmh: 10
    protocol: FE00
    tier: likely
  - models: "WalkingPad R2 and relatives"
    namePrefixes: ["RC", "RG", "RH", "RI", "RL", "RN", "RS", "Rc"]
    maxSpeedKmh: 12
    protocol: FE00
    tier: confirmed
  - models: "R1S variants"
    namePrefixes: ["KS-R1AC", "KS-R1SC", "KS-HC-R1AC", "KS-HC-R1SC", "KS-SC-R1SC"]
    maxSpeedKmh: 12
    protocol: FE00
    tier: likely
  - models: "KS-F0, KS-F1"
    namePrefixes: ["F0", "F1"]
    maxSpeedKmh: 12
    protocol: FE00
    tier: likely
  - models: "K12, K12-PRO-bt"
    namePrefixes: ["K1", "Kc"]
    maxSpeedKmh: 12
    protocol: FE00
    tier: likely
  - models: "GymnasX1, V2"
    namePrefixes: ["X1", "V2"]
    maxSpeedKmh: 12
    protocol: FE00
    tier: likely
  - models: "K15, K15 Pro"
    namePrefixes: ["K2", "KF", "KS-ZY-K15P"]
    maxSpeedKmh: 15
    protocol: FE00
    tier: likely
  - models: "T1, T12F"
    namePrefixes: ["T1"]
    maxSpeedKmh: 15
    protocol: FE00
    tier: likely
  - models: "M1H"
    namePrefixes: ["M1H"]
    maxSpeedKmh: 15
    protocol: FE00
    tier: likely
  # Standard FTMS, no hardware seen yet
  - models: "KingSmith Z1, Z1D/P/R/SE/Pro"
    namePrefixes: ["KS-HD-Z1", "KS-MD-Z1H", "KS-HD-Z1D", "KS-HD-ZR6", "KS-HD-Z1E", "KS-EW-Z1"]
    maxSpeedKmh: 6
    protocol: FTMS
    tier: untested
  - models: "KingSmith R3 Just Walk"
    namePrefixes: ["KS-AP-RF3", "KS-HD-R3F"]
    maxSpeedKmh: 6
    protocol: FTMS
    tier: untested
  - models: "KingSmith R3 Hybrid"
    namePrefixes: ["KS-AP-RP3", "KS-AP-RQ3", "KS-HD-R3P", "KS-HD-R3Q"]
    maxSpeedKmh: 12
    protocol: FTMS
    tier: untested
  - models: "KingSmith X218, X214"
    namePrefixes: ["KS-AP-X218", "KS-NG-X18F3", "KS-NACH-X18F3", "KS-NG-X55"]
    maxSpeedKmh: 18
    protocol: FTMS
    tier: untested
  - models: "Other FTMS treadmills (Z3, G15, G2, K20S, R2E, MX3, MX8, MC11, W1, P1E, MT1)"
    namePrefixes: []
    maxSpeedKmh: null
    protocol: FTMS
    tier: untested
---

{% import "components/link.njk" as linkComponent %}

<article id="laufmaus">
    <section class="light bg-laufmaus-accent onDarkToDark !min-h-[80vh]" id="hero">
        <div class="container">
            <h1 class="col-span-12 md:-mb-20 md:max-w-3xl">
                Laufmaus
            </h1>
            <div class="description col-span-12 md:col-span-8 md:mt-20">
                <p class="font-bold text-2xl">
                    an alternative, feature rich walkingpad app.
                </p>
                <p>
                    Laufmaus is an alternative app for controlling walkingpads, designed to offer enhanced features and a better user experience compared to most manufacturers' apps:
                </p>
                <ul class="!mt-3 space-y-3 ps-2">
                    <li class="flex items-center gap-2">{% icon "heart-pulse",
                        {
                            "class": "stroke-gray-700 dark:stroke-gray-200",
                            "stroke-width": 2
                        } %}
                        {{ 
                            linkComponent.link(
                                href="#heart-rate-monitoring",
                                text="Heart Rate Monitoring",
                                title="Heart Rate Monitoring section"
                            ) 
                        }}
                    </li>
                    <li class="flex items-center gap-2">{% icon "bell-dot",
                        {
                            "class": "stroke-gray-700 dark:stroke-gray-200",
                            "stroke-width": 2
                        } %}
                        {{ 
                                linkComponent.link(
                                    href="#live-activity",
                                    text="Live Activity Integration",
                                    title="Live Activity Integration section"
                                ) 
                        }}
                    </li>
                    <li class="flex items-center gap-2">{% icon "circle-gauge",
                        {
                            "class": "stroke-gray-700 dark:stroke-gray-200",
                            "stroke-width": 2
                        } %}
                        {{
                                linkComponent.link(
                                    href="#speed-control",
                                    text="Custom Speed Control with 0,1km/h steps",
                                    title="Speed Control section"
                                )
                        }}
                    </li>
                    <li class="flex items-center gap-2">{% icon "square-check-big",
                        {
                            "class": "stroke-gray-700 dark:stroke-gray-200",
                            "stroke-width": 2
                        } %}
                        {{ 
                                linkComponent.link(
                                    href="#compatible-devices",
                                    text="Compatible with 50+ WalkingPads (Kingsmith, FTMS, …)",
                                    title="Compare with manufacturer apps section"
                                ) 
                        }}
                    </li>
                </ul>

                {% include "components/laufmaus/appstore_cta.njk" %}
            </div>
            <div class="hidden md:block relative col-span-12 row-start-2 md:row-auto bg-gray-800 md:bg-transparent p-4 md:p-0 md:col-span-4 h-64 md:h-auto overflow-hidden md:overflow-visible md:-mt-24 md:mb-28">
                <img src="/img/laufmaus/laufmaus-iphone17pro-basic--desktop.png" alt="Laufmaus App Mockup" class="relative z-10 dark:hidden">
                {# TODO: dark image is old. #}
                <img src="/img/laufmaus/laufmaus-iphone17pro-basic--desktop--dark.png" alt="Laufmaus App Mockup Dark" class="relative z-10 hidden dark:block">
                <div class="hidden md:block bg-gray-900 h-full w-full absolute top-4 left-4 z-0 rounded-3xl"></div>
            </div>
        </div>
    </section>
    <section class="dark !bg-[#0F3D3E]" id="heart-rate-monitoring">
        <div class="container md:items-end">
            <div class="description col-span-12 md:col-span-7">
                <h2 class="!text-gray-100">
                    Heart Rate Monitoring
                </h2>
                <p class="!text-gray-200">
                    Connect your heart rate monitor to the app and track your heart rate during workouts:
                    <ul class="!list-disc list-inside space-y-2 ps-4">
                        <li class="!text-gray-200">Real-time heart rate display during workouts.</li>
                        <li class="!text-gray-200">Integration with Apple Health to store detailed workout data, including heart rate information.</li>
                        <li class="!text-gray-200">Integration with Google Health Connect.</li>
                        <li class="!text-gray-200">
                            {{
                                linkComponent.link(
                                    customClasses="!text-gray-200 underline",
                                    href="#compatible-devices",
                                    text="See compatible devices here",
                                    title="See compatible devices section"
                                )
                            }}
                        </li>
                    </ul>
                </p>
            </div>
            <div class="col-span-12 md:col-span-5 md:order-first">
                <img src="/img/laufmaus/laufmaus-hrm-monitor--desktop.png" alt="Laufmaus Heart Rate Monitoring Screenshot" class="hidden md:block">
                <img src="/img/laufmaus/laufmaus-hrm-monitor--mobile.png" alt="Laufmaus Heart Rate Monitoring Screenshot" class="md:hidden">
            </div>
        </div>
    </section>
    <section class="dark" id="live-activity">
        <div class="container md:items-end">
            <div class="description col-span-12 md:col-span-7">
                <div class="flex gap-2">
                    <p class="text-sm border border-laufmaus-accent !text-laufmaus-accent px-2 py-1 rounded-full bg-gray tracking-normal">beta</p>
                    <p class="text-sm border border-laufmaus-accent !text-laufmaus-accent px-2 py-1 rounded-full bg-gray tracking-normal">iOS only</p>
                </div>
                <h2 class="!text-gray-100">
                    Live Activity Integration
                </h2>
                <img src="/img/laufmaus/laufmaus-live-activity--mobile.png" alt="Laufmaus Live Activity Screenshot" class="md:hidden">
                <p class="!text-gray-200">
                    Receive real-time notifications about your workout progress, including distance covered, calories burned, and time elapsed. Stay motivated and informed throughout your exercise session.
                </p>
                <p class="!text-gray-200 italic">
                    Note: This feature is currently in beta and only works on iOS 16.1 and later.
                </p>
            </div>
            <div class="col-span-12 md:col-span-5">
                <img src="/img/laufmaus/laufmaus-live-activity--desktop.png" alt="Laufmaus Live Activity Screenshot" class="hidden md:block">
            </div>
        </div>
    </section>
    <section class="light bg-gray-100" id="speed-control">
        <div class="container md:items-end">
            <div class="description col-span-12 md:col-span-7">
                <h2>
                    Speed Control
                </h2>
                <p>
                    Control your walkingpad speed directly from the app. Larger buttons offer easier speed adjustments, allowing you to find your perfect pace without interrupting your workout.
                </p>
                <div class="flex items-center gap-3 !mt-6">
                    <h3>0,1 km/h Steps</h3>
                    <p class="text-sm border border-amber-600 !text-amber-700 px-2 py-1 rounded-full tracking-normal leading-none">experimental</p>
                </div>
                <p>
                    Adjust your speed in 0,1 km/h steps for more control over your pace. Most manufacturer apps only support 0,5 km/h or 1 km/h steps.
                </p>
            </div>
            <div class="col-span-12 md:col-span-5 md:order-first">
                <img src="/img/laufmaus/laufmaus-speed-control--desktop.png" alt="Laufmaus Speed Control Screenshot" class="hidden md:block">
                <img src="/img/laufmaus/laufmaus-speed-control--mobile.png" alt="Laufmaus Speed Control Screenshot" class="md:hidden">
            </div>
        </div>
    </section>
