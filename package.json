{
  "name": "fschoenfeldt-website",
  "version": "1.0.0",
  "description": "Frederik Schönfeldt Website",
  "scripts": {
    "clean": "del _site",
    "watch-css": "tailwindcss -i ./assets/css/styles.css -o ./src/_build/css/styles.css -w",
    "watch-js": "npx esbuild ./assets/js/app.js ./assets/js/app_vacation.js ./assets/js/app_manager.js --outdir=./src/_build/js/ --bundle --target=es2018 --watch",
    "start": "NODE_ENV=development concurrently \"node hash\"  \"ELEVENTY_ENV=development eleventy --serve\"  \"npm:watch-*\"",
    "start:e2e": "ELEVENTY_ENV=production http-server _site --port 8088",
    "build-css": "tailwindcss -i ./assets/css/styles.css -o ./_site/css/styles.css --minify",
    "build-js": "npx esbuild ./assets/js/app.js ./assets/js/app_vacation.js ./assets/js/app_manager.js --outdir=./_site/js/ --bundle --target=es2018 --minify",
    "cv": "NODE_ENV=production npx playwright test ./tests/cv.print.spec.ts",
    "prebuild": "npm run clean",
    "build": "NODE_ENV=production concurrently \"npm:build-*\"",
    "postbuild": "node hash && ELEVENTY_ENV=production eleventy && npm run cv",
    "test:unit": "npx playwright test -c assets/js/",
    "test:e2e": "npx playwright test",
    "test": "pnpm build && pnpm test:unit && pnpm test:e2e",
    "format": "prettier --write ."
  },
  "keywords": [
    "eleventy",
    "starter",
    "TailwindCSS",
    "Alpine.js"
  ],
  "author": "Yann Haefliger<hello@needbrainz.com>",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-upgrade-help": "^3.0.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.17.5",
    "chart.js": "^4.6.1",
    "concurrently": "10.0.7",
    "debounce": "^4.0.0",
    "del-cli": "^8.0.1",
    "eleventy-plugin-sharp": "^0.1.1",
    "esbuild": "0.28.2",
    "html-minifier": "^5.2.0",
    "http-server": "^14.1.1",
    "md5": "^2.3.0",
    "prettier": "3.10.1",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "vanilla-cookieconsent": "3.3.0"
  },
  "dependencies": {
    "eleventy-plugin-icons": "^4.6.0",
    "lucide-static": "^1.73.0"
  }
}
